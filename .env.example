# ==========================================
# ComicCraft Environment Configuration
# ==========================================

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Names (Fast and high quota models)
GEMINI_FLASH_MODEL=gemini-flash-lite-latest
GEMINI_PRO_MODEL=gemini-3.8-flash

# Hugging Face API Key (Optional for cloud SD v1.5 image generation)
HF_API_KEY=your_huggingface_api_key_here

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
